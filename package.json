{
  "name": "labs",
  "private": true,
  "version": "0.1.0",
  "description": "Darshan Ahirrao's public work: open-source agent instrumentation and closed-source client demos.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
